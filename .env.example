NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_dev_team
DATABASE_USER=ai_dev_team
DATABASE_PASSWORD=change_me
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Companies, repositories, sources and AI policy. See tenants.example.yaml.
TENANTS_FILE=tenants.yaml
# Company packs (folders separated by ":"); when set, they replace TENANTS_FILE. See docs/packs.md.
# GUILDA_PACKS=/home/you/guilda-packs/company-a:/home/you/guilda-packs/company-b
# Language of the panel, Telegram, engine questions and core prompts: pt-BR or en. See docs/languages.md.
GUILDA_LANG=pt-BR
# Operator token for /api (VS Code/MCP). Empty disables the API. Generate: openssl rand -hex 32
API_TOKEN=
WORKSPACE_ROOT=./workspaces
# Files sent with tasks; outside workspaces, mounted read-only for the agent.
ATTACHMENTS_ROOT=./attachments
# Card source polling runs inside the API process. "false" disables it (e.g. extra API replicas).
SOURCE_POLLING=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_FILES=10
CODEX_BIN=/usr/local/bin/codex
CLAUDE_BIN=/usr/local/bin/claude
# Gemini CLI needs Node 20+ as the system node; NodeSource's npm installs it in /usr/bin.
GEMINI_BIN=/usr/bin/gemini
CODEX_TIMEOUT_MS=1800000
CLAUDE_TIMEOUT_MS=1800000
# Dedicated empty home, one subdirectory per tenant. Never point to your own home.
AGENT_HOME=./.agent-home
BWRAP_BIN=bwrap
MAX_OUTPUT_BYTES=1048576
MAX_ATTEMPTS=3
# "/ai ..." revisions accepted per task (cost and loop bound).
MAX_REVISIONS=10
RETRY_DELAY_MS=30000
TEST_TIMEOUT_MS=600000
# Times failing test output is handed back to the agent to fix before giving up (0 disables).
TEST_FIX_ATTEMPTS=2

# Per-company secrets, referenced by the packs (requires.yaml) or tenants.yaml as ${NAME}.
# npm run setup asks for the ones your packs need. These match tenants.example.yaml.
ACME_GITHUB_TOKEN=
ACME_GITHUB_WEBHOOK_SECRET=
ACME_OPENAI_API_KEY=
ACME_OPENAI_API_KEY_2=
ACME_ANTHROPIC_API_KEY=
ACME_GEMINI_API_KEY=
INITECH_GITHUB_TOKEN=
INITECH_JIRA_TOKEN=
INITECH_GITHUB_WEBHOOK_SECRET=
INITECH_ANTHROPIC_API_KEY=
GLOBEX_BITBUCKET_TOKEN=
GLOBEX_BITBUCKET_WEBHOOK_SECRET=
GLOBEX_JIRA_TOKEN=
GLOBEX_ANTHROPIC_API_KEY=

# Static ngrok domain for the webhook tunnel service (scripts/install-services.sh --ngrok).
NGROK_DOMAIN=

# Telegram (optional): notices of decisions and PRs, Retry/Cancel buttons.
# Create the bot with @BotFather, send it "hi" and use the id of your chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_PR=true
# Public URL of the panel (the ngrok domain); without it the messages have no link.
WEB_PUBLIC_URL=
# Panel (/app on the ngrok domain). Generate the hash with: npm run web:password
WEB_PASSWORD_HASH=
# Interval of the panel's live updates, in ms.
EVENTS_POLL_MS=2000
