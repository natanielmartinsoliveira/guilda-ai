{
  "name": "ai-dev-team",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "start": "node dist/main.js",
    "worker": "ts-node src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "test:web": "npm --prefix web test",
    "design:check": "ts-node src/design/design-cli.ts",
    "migration:run": "ts-node node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "doctor": "ts-node src/doctor.ts",
    "packs:compare": "ts-node src/tenants/compare-cli.ts",
    "project:add": "ts-node src/projects/project-add-cli.ts",
    "pack:init": "ts-node src/projects/pack-init-cli.ts",
    "method:check": "ts-node src/methods/check-cli.ts",
    "public:check": "ts-node src/public/public-check-cli.ts",
    "setup": "ts-node src/setup/setup-cli.ts",
    "web:password": "ts-node src/web/password-cli.ts",
    "build:web": "if [ -f web/package.json ]; then npm --prefix web ci && npm --prefix web run build; else echo 'web/ ainda n\u00e3o existe (etapa 3b)'; fi",
    "mcp": "node dist/mcp/server.js",
    "start:all": "bash scripts/run-all.sh",
    "services:install": "bash scripts/install-services.sh",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "amqplib": "^0.10.9",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "yaml": "^2.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "pg-mem": "^3.0.5",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
